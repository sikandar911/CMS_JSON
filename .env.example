# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cms_db?schema=public"

# Authentication
JWT_SECRET="your-secret-key-here"

# Upstash Redis (Optional - for production rate limiting)
# Get these from: https://console.upstash.com/
# Rate limiting will be disabled if these are not set (OK for local development)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Next.js
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
